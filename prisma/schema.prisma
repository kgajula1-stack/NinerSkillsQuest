generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Student {
  id            String             @id @default(cuid())
  displayName   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  courseRecords StudentCourse[]
  careerGoal    StudentCareerGoal?
  transcripts   Transcript[]

  @@map("students")
}

model Course {
  id                   String                      @id
  code                 String                      @unique
  title                String
  isActive             Boolean                     @default(true)
  skillMappings        CourseSkill[]
  studentRecords       StudentCourse[]
  transcriptCandidates TranscriptCourseCandidate[]

  @@map("courses")
}

model Skill {
  id                    String                 @id
  name                  String                 @unique
  description           String?
  courseMappings        CourseSkill[]
  roadmapTargets        RoadmapSkill[]
  courseRecommendations CourseRecommendation[]
  practiceResources     PracticeResource[]

  @@map("skills")
}

model CourseSkill {
  courseId String
  skillId  String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model StudentCourse {
  id                    String                     @id @default(cuid())
  studentId             String
  courseId              String
  status                String                     @default("COMPLETED")
  completedAt           DateTime?
  transcriptCandidateId String?                    @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  student               Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course                Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  transcriptCandidate   TranscriptCourseCandidate? @relation("AcceptedTranscriptCourse", fields: [transcriptCandidateId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@index([courseId])
  @@map("student_courses")
}

model CareerRoadmap {
  id           String              @id
  name         String              @unique
  description  String
  isActive     Boolean             @default(true)
  skillTargets RoadmapSkill[]
  studentGoals StudentCareerGoal[]

  @@map("career_roadmaps")
}

model RoadmapSkill {
  roadmapId String
  skillId   String
  sortOrder Int           @default(0)
  roadmap   CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roadmapId, skillId])
  @@index([skillId])
  @@map("roadmap_skills")
}

model EmployerProfile {
  id             String              @id @default(cuid())
  name           String
  location       String
  industry       String?
  isIllustrative Boolean             @default(true)
  studentGoals   StudentCareerGoal[]

  @@unique([name, location])
  @@map("employer_profiles")
}

model StudentCareerGoal {
  id                String           @id @default(cuid())
  studentId         String           @unique
  roadmapId         String?
  employerProfileId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roadmap           CareerRoadmap?   @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  employerProfile   EmployerProfile? @relation(fields: [employerProfileId], references: [id], onDelete: SetNull)

  @@index([roadmapId])
  @@index([employerProfileId])
  @@map("student_career_goals")
}

model Transcript {
  id               String                      @id @default(cuid())
  studentId        String
  originalFileName String
  mediaType        String
  sizeBytes        Int
  storageKey       String                      @unique
  status           String                      @default("UPLOADED")
  uploadedAt       DateTime                    @default(now())
  reviewedAt       DateTime?
  student          Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  candidates       TranscriptCourseCandidate[]

  @@index([studentId, uploadedAt])
  @@map("transcripts")
}

model TranscriptCourseCandidate {
  id                    String         @id @default(cuid())
  transcriptId          String
  rawCourseCode         String
  rawCourseTitle        String?
  matchedCourseId       String?
  reviewStatus          String         @default("PENDING")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  transcript            Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  matchedCourse         Course?        @relation(fields: [matchedCourseId], references: [id], onDelete: SetNull)
  acceptedStudentCourse StudentCourse? @relation("AcceptedTranscriptCourse")

  @@index([transcriptId, reviewStatus])
  @@index([matchedCourseId])
  @@map("transcript_course_candidates")
}

model CourseRecommendation {
  id        String @id @default(cuid())
  skillId   String
  code      String
  title     String
  url       String
  sortOrder Int    @default(0)
  skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, code])
  @@index([skillId, sortOrder])
  @@map("course_recommendations")
}

model PracticeResource {
  id        String @id @default(cuid())
  skillId   String
  title     String
  url       String
  sortOrder Int    @default(0)
  skill     Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, url])
  @@index([skillId, sortOrder])
  @@map("practice_resources")
}
